# =====================================================================
# ĐẲNG CẤP COFFEE POS - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env.production trên VPS và thay đổi toàn bộ giá trị bí mật:
#   cp .env.production.example .env.production && chmod 600 .env.production
# =====================================================================

# 1. DATABASE CREDENTIALS (Bắt buộc mật khẩu mạnh tối thiểu 16 ký tự)
DBMS_PASSWORD=DangCapCoffee_SecureMysql_Pwd2026!

# 2. REDIS SECURITY
REDIS_PASSWORD=DangCapCoffee_SecureRedis_Pwd2026!

# 3. JWT SIGNER KEY (HMAC-SHA512: Khuyến nghị chuỗi Base64/Hex ngẫu nhiên >= 64 ký tự)
# Tạo bằng lệnh Linux: openssl rand -base64 64
JWT_SIGNER_KEY=a8f9c2d4e7b1a03685f29e1d4c7b0a3f8592e1d4c7b0a3f8592e1d4c7b0a3f8592e1d4c7b0a3f8592e1d4c7b0a3f8592e1d4c7b0a3f8592e1d4c7b0a3f8

# 4. INITIAL ADMIN ACCOUNT CREDENTIALS (Được tạo tự động nếu DB chưa có admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DangCapAdmin_Prod2026!@#

# 5. DOMAIN & CORS CONFIGURATION
DOMAIN_NAME=pos.dangcapcoffee.vn
CORS_ALLOWED_ORIGINS=https://pos.dangcapcoffee.vn

# 6. CLOUDINARY MEDIA CDN (Lưu trữ ảnh sản phẩm, nguyên liệu)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. AI BUSINESS ASSISTANT (Tùy chọn: Bật trợ lý phân tích dữ liệu)
AI_ENABLED=true
OPENAI_API_KEY=sk-proj-your_actual_openai_api_key_here
