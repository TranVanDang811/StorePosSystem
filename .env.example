# =================================================================
# POS Backend - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =================================================================

# Server & Profile
SERVER_PORT=8080
CONTEXT_PATH=/backend
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL 8.0)
DBMS_CONNECTION=jdbc:mysql://localhost:3306/backend?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DBMS_USERNAME=root
DBMS_PASSWORD=root
JPA_DDL_AUTO=update
SHOW_SQL=true
FORMAT_SQL=false
ENABLE_FLYWAY=false

# Redis Cache & Distributed Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=1000ms
REDIS_CONNECT_TIMEOUT=500ms
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_ENABLED=true

# JWT Security (Signer key must be at least 256-bit / 32-bytes base64 encoded)
JWT_SIGNER_KEY=your_base64_jwt_signer_key_at_least_32_bytes_long_here===
JWT_VALID_DURATION=86400
JWT_REFRESH_DURATION=604800

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Seed Admin Credentials (Auto-created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin12345

# Gmail SMTP Configuration (Optional - for email notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Cloudinary Cloud Storage (For product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Logging & Monitoring
LOG_LEVEL=DEBUG
ENABLE_SWAGGER=true

# AI Business Assistant (Spring AI / OpenAI Compatible)
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
AI_MONTHLY_TOKEN_LIMIT=500000
AI_DAILY_TOKEN_LIMIT=50000


